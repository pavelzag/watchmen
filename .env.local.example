# ─────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# From Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─────────────────────────────────────────────────────────────
# Access control (choose one or both)
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed email addresses
ALLOWED_EMAILS=you@gmail.com,colleague@company.com

# OR restrict entire domain (e.g. "yourcompany.com")
# ALLOWED_DOMAIN=yourcompany.com

# ─────────────────────────────────────────────────────────────
# Gemini
# ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# GCP
# ─────────────────────────────────────────────────────────────
# Set to "true" to use fixture data instead of real GCP API calls
# Great for local development without GCP credentials
USE_MOCK_DATA=true

# Comma-separated GCP project IDs to scan (ignored when USE_MOCK_DATA=true)
GCP_PROJECTS=my-project-id,another-project-id

# Base64-encoded service account JSON key (ignored when USE_MOCK_DATA=true)
# Generate: base64 -i service-account.json | tr -d '\n'
GCP_SERVICE_ACCOUNT_KEY=
