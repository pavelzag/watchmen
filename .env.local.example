# ─────────────────────────────────────────────────────────────
# Demo mode
# Set DEMO_MODE=true to enable one-click sign-in with fixture
# data. No Google OAuth or GCP credentials are required.
# Also set USE_MOCK_DATA=true when DEMO_MODE=true.
# ─────────────────────────────────────────────────────────────
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here
# Required for self-hosted/Docker deployments where Auth.js sees localhost,
# private IPs, reverse proxies, or custom hostnames.
AUTH_TRUST_HOST=true

# Local app sign-in is enabled by default for self-hosted installs.
# Set WATCHMEN_LOCAL_PASSWORD to require a password on the login screen.
WATCHMEN_LOCAL_AUTH=true
WATCHMEN_LOCAL_EMAIL=local@watchmen.dev
WATCHMEN_LOCAL_PASSWORD=
WATCHMEN_LOCAL_AUTH_ENFORCE_ALLOWLIST=false

# Optional Google app sign-in. This is app identity only, not GCP cloud access.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub app sign-in.
# Authorized callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Access control (choose one or both)
# Applies to Google/GitHub OAuth sign-in. Local app sign-in ignores this unless
# WATCHMEN_LOCAL_AUTH_ENFORCE_ALLOWLIST=true.
# Not required when DEMO_MODE=true.
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed email addresses
ALLOWED_EMAILS=

# OR restrict entire domain (e.g. "yourcompany.com")
# ALLOWED_DOMAIN=yourcompany.com

# ─────────────────────────────────────────────────────────────
# GCP
# ─────────────────────────────────────────────────────────────
# Set to "true" to use fixture data instead of real GCP API calls
# Great for local development without GCP credentials
# Must be "true" when DEMO_MODE=true
USE_MOCK_DATA=true

# Comma-separated GCP project IDs to scan (ignored when USE_MOCK_DATA=true)
GCP_PROJECTS=my-project-id,another-project-id

# Base64-encoded service account JSON key (ignored when USE_MOCK_DATA=true)
# Generate: base64 -i service-account.json | tr -d '\n'
GCP_SERVICE_ACCOUNT_KEY=

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Required for non-demo deployments (snapshots, compliance history, AI keys)
# Also required in demo mode if you want risk acceptance and compliance history
POSTGRES_URL=postgresql://postgres:dev@localhost:5432/watchmen

NEXT_PUBLIC_VERSION=0.2.0
